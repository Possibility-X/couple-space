# 复制此文件为 .env 并填写真实值
# Copy to .env and fill in real values

# 域名 (仅生产环境需要)
DOMAIN=your-domain.com

# JWT 密钥 (随机32位以上字符串)
JWT_SECRET=change-this-to-a-random-secret-string-32chars

# 前端域名 (生产环境 CORS 白名单)
CORS_ORIGIN=https://your-domain.com

# 相恋纪念日 (格式: YYYY-MM-DD)
ANNIVERSARY_DATE=2023-01-01

# 后端端口
PORT=3000

# Node 环境
NODE_ENV=development

# 上传文件限制 (MB)
MAX_FILE_SIZE_MB=100
